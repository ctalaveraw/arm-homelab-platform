# Copy to .env and keep deployment values local. No credentials belong here.
STATE_SERVICES_ROOT=/srv/storage/state/services

# Public chat hostname only, with no scheme, port or path.
ZULIP_FQDN=

# Restricted application endpoint. Never use the public chat URL as upstream.
ZULIP_UPSTREAM=

# Choose a free Docker subnet; check LAN, VPN and Docker routes before use.
# The two addresses must be distinct hosts in that subnet, excluding gateway.
PUBLIC_INGRESS_SUBNET=
CADDY_TUNNEL_IP=
CLOUDFLARED_CONTAINER_IP=

# The tunnel token lives only in the SD-backed file installed by the helper.
# Configure the Cloudflare published application service as http://server:8080.
