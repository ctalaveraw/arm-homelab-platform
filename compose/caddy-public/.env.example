# Copy to .env and keep deployment values local. No credentials belong here.
STATE_SERVICES_ROOT=/srv/storage/state/services

# Base Zulip hostname (EXTERNAL_HOST), with no scheme, port or path.
# Keep this value stable when changing organization URLs.
ZULIP_FQDN=

# Optional space-separated organization hostnames, each a sibling of the base
# or one label below it. Service-first siblings use the existing wildcard cert.
# Example: 'zulip-openops.example.com zulip-projects.example.com'
# Leave empty for the existing single-organization deployment.
ZULIP_ORG_HOSTS=

# JSON object mapping internal organization IDs to the same custom hostnames.
# Example: '{"openops":"zulip-openops.example.com","projects":"zulip-projects.example.com"}'
# Leave empty for the single organization or default nested-subdomain layout.
ZULIP_REALM_HOSTS=

# The controller profile overrides this with the unpublished Docker service.
ZULIP_UPSTREAM=http://zulip:80

# Choose a free Docker subnet; check LAN, VPN and Docker routes before use.
# The two addresses must be distinct hosts in that subnet, excluding gateway.
PUBLIC_INGRESS_SUBNET=
CADDY_TUNNEL_IP=
CLOUDFLARED_CONTAINER_IP=

# Separate nonoverlapping internal Docker subnet for Caddy -> Zulip.
# CADDY_ZULIP_IP is one usable host address, excluding the first/gateway address.
ZULIP_PROXY_SUBNET=
CADDY_ZULIP_IP=
ZULIP_CONTAINER_IP=

# Zulip and outgoing SMTP submission. Credentials are entered by the helper.
ZULIP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_USER=
SMTP_FROM=

# The tunnel token lives only in the SD-backed file installed by the helper.
# Configure the Cloudflare published application service as http://server:8080.
