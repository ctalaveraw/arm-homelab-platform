STATE_SERVICES_ROOT=/srv/storage/state/services

# Controller LAN address; last supplied address was 10.0.0.50.
# Check current listeners and address before deployment. Never use 0.0.0.0.
PROXY_BIND_IP=

# Public chat hostname only, with no scheme, port or path.
ZULIP_FQDN=
ACME_EMAIL=

# Actual application host's restricted HTTP endpoint, e.g. http://10.x.x.x:8080.
# Do not use the public chat URL here; that would loop back into this proxy.
ZULIP_UPSTREAM=
