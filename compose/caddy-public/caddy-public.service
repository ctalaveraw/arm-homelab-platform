[Unit]
Description=Controller Zulip, Caddy and Cloudflare Tunnel
Documentation=https://developers.cloudflare.com/tunnel/
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
RequiresMountsFor=/srv/storage/state/services/caddy-public /srv/storage/state/services/cloudflared /srv/storage/state/services/zulip

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/platform/compose/caddy-public
ExecStartPre=/usr/local/sbin/caddy-public-check-storage
ExecStartPre=/usr/local/sbin/zulip-compose run --rm --no-deps server caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
ExecStart=/usr/local/sbin/zulip-compose up -d --wait --wait-timeout 900
ExecStop=/usr/local/sbin/zulip-compose down
ExecStopPost=-/usr/local/sbin/zulip-compose down
TimeoutStartSec=1200
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
