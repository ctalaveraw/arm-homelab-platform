# Private LAN deployment. Keep Forgejo state separate from retained Gitea data.
STATE_SERVICES_ROOT=/srv/storage/state/services

FORGEJO_FQDN=git.lab.home.arpa
FORGEJO_ROOT_URL=http://git.lab.home.arpa:3000/

# Set both to the controller LAN IPv4. Private HTTPS needs a separate rollout.
FORGEJO_BIND_IP=
FORGEJO_SSH_BIND_IP=
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2223

# Check these Docker addresses against LAN, VPN and existing Docker routes.
# PROXY_CONTAINER_IP must match the optional private compose/caddy profile.
INGRESS_SUBNET=172.30.250.0/28
PROXY_CONTAINER_IP=172.30.250.2
FORGEJO_CONTAINER_IP=172.30.250.3
