# Forgejo runs beside legacy Gitea during migration; NEVER reuse its data.
STATE_SERVICES_ROOT=/srv/storage/state/services

# LAN preview identity; change to git.your-domain.tld for HTTPS cutover.
FORGEJO_FQDN=forgejo.lab.home.arpa
FORGEJO_ROOT_URL=http://forgejo.lab.home.arpa:3002/

# Controller LAN IPv4 for preview. Set HTTP binding to 127.0.0.1 after HTTPS.
FORGEJO_BIND_IP=
FORGEJO_SSH_BIND_IP=
# Temporary coexistence port. After Gitea is stopped AND disabled, set 3000
# and update FORGEJO_ROOT_URL to match. See the migration runbook, step 7.
FORGEJO_HTTP_PORT=3002
FORGEJO_SSH_PORT=2223

# Dedicated Docker ingress network. Check host/LAN/VPN/Docker route overlap.
# Keep proxy IP identical in compose/caddy/.env. Do not use existing subnets.
INGRESS_SUBNET=172.30.250.0/28
PROXY_CONTAINER_IP=172.30.250.2
FORGEJO_CONTAINER_IP=172.30.250.3
