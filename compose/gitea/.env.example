# Gitea deployment environment
#
# Copy to .env in this directory and populate host-specific values.
# .env is excluded from Git; .env.example is safe to commit.
#
# Validate with:
# docker-compose --env-file .env -f compose.yml config

# ----------------------------------------------------------
# Persistent application storage
# ----------------------------------------------------------

# Root directory for persistent services on the SD filesystem.
# Must agree with the Ansible-managed storage hierarchy.
#
# IMPORTANT:
# The startup guard must verify the actual SD mount and its label.
# Directory existence alone does not establish storage availability.
STATE_SERVICES_ROOT=/srv/storage/state/services

# ----------------------------------------------------------
# Service identity / OpenWRT DNS
# ----------------------------------------------------------

# OpenWRT dnsmasq provides local lab.home.arpa resolution.
#
# Host record:
#   gitops-controller-01.lab.home.arpa -> R5C LAN address
#
# Service CNAME:
#   gitea.lab.home.arpa -> gitops-controller-01.lab.home.arpa
#
# Use the service identity in application-generated URLs,
# never the physical host's hostname.
#
# ROOT_URL currently uses HTTP :3000 for initial LAN bootstrap.
# Revisit this configuration when introducing HTTPS/reverse proxy.
GITEA_FQDN=gitea.lab.home.arpa

# ----------------------------------------------------------
# Host networking
# ----------------------------------------------------------

# IPv4 address assigned to the R5C's intended LAN interface.
#
# This controls Docker's listening address, not Gitea's
# advertised hostname. Change this if the host moves networks.
#
# Required. Deliberately blank in the public example.
# Avoid 0.0.0.0 unless exposure on every interface is intentional.
GITEA_BIND_IP=
