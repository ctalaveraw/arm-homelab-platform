# Copy to .env; use the same FQDN and proxy IP as compose/forgejo/.env.
STATE_SERVICES_ROOT=/srv/storage/state/services

# A real registered hostname, e.g. git.your-domain.tld. No scheme or port.
FORGEJO_FQDN=
ACME_EMAIL=

# Controller LAN IPv4 address. Never use the WAN address here.
PROXY_BIND_IP=

# Must agree with Forgejo's dedicated ingress network.
# Verify this subnet does not overlap host, LAN, VPN or Docker routes.
PROXY_CONTAINER_IP=172.30.250.2
