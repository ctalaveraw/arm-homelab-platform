# Gotify deployment template.
# Copy to .env and supply host-specific values.
# Never commit the populated .env.

# SD-backed namespace. Must match Ansible's storage convention.
STATE_SERVICES_ROOT=/srv/storage/state/services

# R5C's LAN interface address.
# This is independent of the OpenWRT DNS service alias.
GOTIFY_BIND_IP=

# Unique bootstrap password. Required before first deployment.
# Do not use Gotify's documented default password.
GOTIFY_ADMIN_INITIAL_PASSWORD=

# OpenWRT dnsmasq service identity:
# gotify.lab.home.arpa -> gitops-controller-01.lab.home.arpa
#
# Initial LAN access: http://gotify.lab.home.arpa:8080/
# Configure HTTPS before using notifications over untrusted networks.
