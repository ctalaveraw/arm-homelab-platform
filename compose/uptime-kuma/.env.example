# Uptime Kuma — host-specific deployment configuration.
# Copy to .env. Never commit the populated .env.

# Ansible-managed persistence namespace on the R5C SD filesystem.
# The systemd startup guard must independently verify the mount.
STATE_SERVICES_ROOT=/srv/storage/state/services

# IPv4 address of the intended host listening interface.
# Required: do not silently fall back to 0.0.0.0.
UPTIME_KUMA_BIND_IP=

# DNS identity (configured separately in OpenWRT dnsmasq):
#
# uptime.lab.home.arpa
#     CNAME gitops-controller-01.lab.home.arpa
#
# Initial URL: http://uptime.lab.home.arpa:3001/
