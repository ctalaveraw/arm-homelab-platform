    {
      "id": 4,
      "title": "Prometheus Process Memory",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"prometheus\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
